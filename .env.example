# Copy this file to .env and fill in your own credentials.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_SUPER_MODEL=deepseek-v4-pro

QQ_BOT_APP_ID=
QQ_BOT_APP_SECRET=
QQ_BOT_SANDBOX=true
MAX_CONCURRENT_MESSAGES=5

BAILIAN_API_KEY=
BAILIAN_BASE_URL=https://{workspace}.{region}.maas.aliyuncs.com/compatible-mode/v1
BAILIAN_WORKSPACE_ID=
BAILIAN_REGION=cn-beijing
BAILIAN_IMAGE_MODEL=qwen-image-3.0-pro

# Image generation: forge uses local Stable Diffusion WebUI Forge; bailian uses Aliyun Model Studio.
IMAGE_PROVIDER=forge
FORGE_API_URL=http://127.0.0.1:7860
FORGE_API_AUTH=
FORGE_WIDTH=1024
FORGE_HEIGHT=1600
FORGE_STEPS=30
FORGE_CFG_SCALE=7
FORGE_SAMPLER=Euler a
FORGE_SCHEDULER=Automatic
FORGE_SEED=2829619350
FORGE_DENOISING_STRENGTH=0.35
FORGE_CLIP_SKIP=2
FORGE_ENSD=31337
FORGE_ETA=0.67
FORGE_HIRES_UPSCALE=1.5
FORGE_HIRES_STEPS=20
FORGE_HIRES_UPSCALER=R-ESRGAN 4x+ Anime6B
FORGE_HIRES_CFG=7

DATABASE_PATH=./data/chat_history.sqlite3
CONTEXT_TURNS=20
BOT_NAME=傻鲸鱼
BOT_PERSONALITY=你是傻鲸鱼，温柔体贴的妹妹型聊天伙伴。
BOT_APPEARANCE=成年海洋系蓝发女仆少女。
